/dts-v1/;
#include "sun50i-a133.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "TrimUI Brick";
	compatible = "trimui,brick", "allwinner,sun50i-a133", "allwinner,sun50i-a100";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gamepad {
		compatible = "gpio-keys";
		label = "TrimUI Brick Gamepad";
		pinctrl-names = "default";
		pinctrl-0 = <&gamepad_pins>;

		button-b {
			label = "B";
			linux,code = <BTN_SOUTH>;
			gpios = <&pio 3 13 GPIO_ACTIVE_LOW>;
		};

		button-y {
			label = "Y";
			linux,code = <BTN_WEST>;
			gpios = <&pio 3 19 GPIO_ACTIVE_LOW>;
		};

		button-select {
			label = "SELECT";
			linux,code = <BTN_SELECT>;
			gpios = <&pio 7 15 GPIO_ACTIVE_LOW>;
		};

		button-start {
			label = "START";
			linux,code = <BTN_START>;
			gpios = <&pio 7 16 GPIO_ACTIVE_LOW>;
		};

		button-up {
			label = "UP";
			linux,code = <BTN_DPAD_UP>;
			gpios = <&pio 3 17 GPIO_ACTIVE_LOW>;
		};

		button-down {
			label = "DOWN";
			linux,code = <BTN_DPAD_DOWN>;
			gpios = <&pio 3 14 GPIO_ACTIVE_LOW>;
		};

		button-left {
			label = "LEFT";
			linux,code = <BTN_DPAD_LEFT>;
			gpios = <&pio 3 15 GPIO_ACTIVE_LOW>;
		};

		button-right {
			label = "RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
			gpios = <&pio 3 16 GPIO_ACTIVE_LOW>;
		};

		button-a {
			label = "A";
			linux,code = <BTN_EAST>;
			gpios = <&pio 3 12 GPIO_ACTIVE_LOW>;
		};

		button-x {
			label = "X";
			linux,code = <BTN_NORTH>;
			gpios = <&pio 3 18 GPIO_ACTIVE_LOW>;
		};

		button-l {
			label = "L";
			linux,code = <BTN_TL>;
			gpios = <&pio 1 4 GPIO_ACTIVE_LOW>;
		};

		button-r {
			label = "R";
			linux,code = <BTN_TR>;
			gpios = <&pio 7 17 GPIO_ACTIVE_LOW>;
		};

		button-l2 {
			label = "L2";
			linux,code = <BTN_TL2>;
			gpios = <&pio 1 2 GPIO_ACTIVE_LOW>;
		};

		button-r2 {
			label = "R2";
			linux,code = <BTN_TR2>;
			gpios = <&pio 1 5 GPIO_ACTIVE_LOW>;
		};

		button-menu {
			label = "MENU";
			linux,code = <BTN_MODE>;
			gpios = <&pio 7 14 GPIO_ACTIVE_LOW>;
		};

		button-f1 {
			label = "F1";
			linux,code = <BTN_TRIGGER_HAPPY1>;
			gpios = <&pio 7 12 GPIO_ACTIVE_LOW>;
		};

		button-f2 {
			label = "F2";
			linux,code = <BTN_TRIGGER_HAPPY2>;
			gpios = <&pio 7 13 GPIO_ACTIVE_LOW>;
		};
	};

	volume-keys {
		compatible = "gpio-keys";
		label = "TrimUI Brick Volume";
		pinctrl-names = "default";
		pinctrl-0 = <&volume_keys_pins>;

		button-volup {
			label = "VOLUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pio 3 21 GPIO_ACTIVE_LOW>;
		};

		button-voldown {
			label = "VOLDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pio 3 20 GPIO_ACTIVE_LOW>;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 20000 0>;
		enable-gpios = <&pio 7 18 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 16 32 64 128 192 255>;
		default-brightness-level = <1>;
	};

	/* SPL establishes CLDO3; no voltage switching is supported. */
	reg_sd_3v3: regulator-sd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "sd-cldo3-boot-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&display_engine {
	status = "okay";
};

&dphy0 {
	assigned-clocks = <&ccu CLK_MIPI_DSI>;
	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0>;
	assigned-clock-rates = <150000000>;
	status = "okay";
};

&dsi0 {
	/* Analogue supply remains boot-established; its physical rail is unknown. */
	status = "okay";

	panel@0 {
		compatible = "trimui,brick-jd9168";
		reg = <0>;
		dsi-lanes = <4>;
		reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
		power0-supply = <&cldo1>;
		power1-supply = <&cldo4>;
		pinctrl-names = "active", "sleep";
		pinctrl-0 = <&dsi_active_pins>;
		pinctrl-1 = <&dsi_sleep_pins>;

		display-timings {
			native-mode = <&panel_timing>;
			panel_timing: timing0 {
				clock-frequency = <51000000>;
				hactive = <1024>;
				vactive = <768>;
				hfront-porch = <36>;
				hback-porch = <16>;
				hsync-len = <4>;
				vfront-porch = <7>;
				vback-porch = <5>;
				vsync-len = <4>;
			};
		};
	};
};

&gpu {
	status = "okay";
};

&gpu_pd {
	status = "okay";
};

&mixer0 {
	assigned-clocks = <&ccu CLK_DE>;
	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0_2X>;
	assigned-clock-rates = <300000000>;
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_sd_3v3>;
	bus-width = <4>;
	broken-cd;
	max-frequency = <25000000>;
	no-1-8-v;
	status = "okay";
};

&mmc1 {
	status = "disabled";
};

/* Keep internal eMMC unavailable. */
&mmc2 {
	status = "disabled";
};

&pio {
	gamepad_pins: gamepad-pins {
		pins = "PD13", "PD19", "PH15", "PH16", "PD17", "PD14",
		       "PD15", "PD16", "PD12", "PD18", "PB4", "PH17",
		       "PB2", "PB5", "PH14", "PH12", "PH13";
		function = "gpio_in";
		bias-pull-up;
	};

	volume_keys_pins: volume-keys-pins {
		pins = "PD21", "PD20";
		function = "gpio_in";
		bias-pull-up;
	};

	dsi_active_pins: dsi-active-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4",
		       "PD5", "PD6", "PD7", "PD8", "PD9";
		function = "dsi0";
	};

	dsi_sleep_pins: dsi-sleep-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4",
		       "PD5", "PD6", "PD7", "PD8", "PD9";
		function = "io_disabled";
		bias-disable;
	};

	pwm0_pin: pwm0-pin {
		pins = "PD23";
		function = "pwm0";
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pin>;
	status = "okay";
};

&r_i2c0 {
	status = "okay";

	pmic@34 {
		compatible = "trimui,brick-panel-supplies";
		reg = <0x34>;

		regulators {
			cldo1: cldo1 {
				regulator-name = "brick-panel-cldo1";
				regulator-always-on;
			};
			cldo4: cldo4 {
				regulator-name = "brick-panel-cldo4";
			};
		};
	};
};

&tcon_lcd0 {
	assigned-clocks = <&ccu CLK_PLL_VIDEO0_4X>, <&ccu CLK_TCON_LCD>;
	assigned-clock-parents = <0>, <&ccu CLK_PLL_VIDEO0_4X>;
	assigned-clock-rates = <612000000>, <306000000>;
	status = "okay";
};

&tcon_top {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

&usb_otg {
	compatible = "trimui,brick-musb", "allwinner,sun8i-a33-musb";
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	compatible = "trimui,brick-usb-phy", "allwinner,sun20i-d1-usb-phy";
	clocks = <&ccu CLK_USB_PHY0>, <&ccu CLK_USB_PHY1>, <&ccu CLK_BUS_EHCI1>;
	clock-names = "usb0_phy", "usb1_phy", "pmu1_clk";
	resets = <&ccu RST_USB_PHY0>, <&ccu RST_USB_PHY1>, <&ccu RST_BUS_EHCI1>;
	reset-names = "usb0_reset", "usb1_reset", "usb1_bus_reset";
	status = "okay";
};
