// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/dts-v1/;
#include "sun50i-a133.dtsi"
#include "sun50i-a133-c0-cpu-opp.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "TrimUI Brick";
	compatible = "trimui,brick", "allwinner,sun50i-a133", "allwinner,sun50i-a100";

	aliases {
		ethernet0 = &wifi;
		serial0 = &uart0;
		serial1 = &uart1;
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gamepad {
		compatible = "gpio-keys";
		label = "TrimUI Brick Gamepad";

		button-b {
			label = "B";
			linux,code = <BTN_SOUTH>;
			gpios = <&pio 3 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-y {
			label = "Y";
			linux,code = <BTN_WEST>;
			gpios = <&pio 3 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-select {
			label = "SELECT";
			linux,code = <BTN_SELECT>;
			gpios = <&pio 7 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-start {
			label = "START";
			linux,code = <BTN_START>;
			gpios = <&pio 7 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-up {
			label = "UP";
			linux,code = <BTN_DPAD_UP>;
			gpios = <&pio 3 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-down {
			label = "DOWN";
			linux,code = <BTN_DPAD_DOWN>;
			gpios = <&pio 3 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-left {
			label = "LEFT";
			linux,code = <BTN_DPAD_LEFT>;
			gpios = <&pio 3 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-right {
			label = "RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
			gpios = <&pio 3 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-a {
			label = "A";
			linux,code = <BTN_EAST>;
			gpios = <&pio 3 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-x {
			label = "X";
			linux,code = <BTN_NORTH>;
			gpios = <&pio 3 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-l {
			label = "L";
			linux,code = <BTN_TL>;
			gpios = <&pio 1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-r {
			label = "R";
			linux,code = <BTN_TR>;
			gpios = <&pio 7 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-l2 {
			label = "L2";
			linux,code = <BTN_TL2>;
			gpios = <&pio 1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-r2 {
			label = "R2";
			linux,code = <BTN_TR2>;
			gpios = <&pio 1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-menu {
			label = "MENU";
			linux,code = <BTN_MODE>;
			gpios = <&pio 7 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-f1 {
			label = "F1";
			linux,code = <BTN_TRIGGER_HAPPY1>;
			gpios = <&pio 7 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-f2 {
			label = "F2";
			linux,code = <BTN_TRIGGER_HAPPY2>;
			gpios = <&pio 7 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};

	fn-switch {
		compatible = "gpio-keys";
		label = "TrimUI Brick Fn";
		pinctrl-names = "default";
		pinctrl-0 = <&fn_switch_pin>;

		button-fn {
			label = "Fn";
			linux,code = <KEY_FN>;
			gpios = <&pio 7 19 GPIO_ACTIVE_HIGH>;
			debounce-interval = <5>;
		};
	};

	volume-keys {
		compatible = "gpio-keys";
		autorepeat;
		label = "TrimUI Brick Volume";

		button-volup {
			label = "VOLUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pio 3 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		button-voldown {
			label = "VOLDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pio 3 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "trimui,brick-radio-pwrseq";
		clocks = <&rtc 0>, <&rtc 1>;
		clock-names = "lpo", "ref";
		reset-gpios = <&r_pio 0 5 GPIO_ACTIVE_LOW>;
	};

	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&pio 7 3 GPIO_ACTIVE_HIGH>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 20000 0>;
		enable-gpios = <&pio 7 18 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 16 32 64 128 192 255>;
		default-brightness-level = <1>;
	};


};

&display_engine {
	status = "okay";
};

&dphy0 {
	assigned-clocks = <&ccu CLK_MIPI_DSI>;
	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0>;
	assigned-clock-rates = <150000000>;
	status = "okay";
};

&dsi0 {
	/* Analogue supply remains boot-established; its physical rail is unknown. */
	status = "okay";

	panel@0 {
		compatible = "trimui,brick-jd9168";
		reg = <0>;
		dsi-lanes = <4>;
		reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
		power0-supply = <&cldo1>;
		power1-supply = <&cldo4>;
		pinctrl-names = "active", "sleep";
		pinctrl-0 = <&dsi_active_pins>;
		pinctrl-1 = <&dsi_sleep_pins>;

		display-timings {
			native-mode = <&panel_timing>;
			panel_timing: timing0 {
				clock-frequency = <51000000>;
				hactive = <1024>;
				vactive = <768>;
				hfront-porch = <36>;
				hback-porch = <16>;
				hsync-len = <4>;
				vfront-porch = <7>;
				vback-porch = <5>;
				vsync-len = <4>;
			};
		};
	};
};

&gpu {
	status = "okay";
};

&gpu_pd {
	status = "okay";
};

&mixer0 {
	assigned-clocks = <&ccu CLK_DE>;
	assigned-clock-parents = <&ccu CLK_PLL_PERIPH0_2X>;
	assigned-clock-rates = <300000000>;
	status = "okay";
};

&mmc0 {
	compatible = "allwinner,sun50i-a133-mmc";
	vmmc-supply = <&cldo3>;
	vqmmc-supply = <&pf_vqmmc>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	cd-debounce-delay-ms = <200>;
	no-mmc;
	no-sdio;
	max-frequency = <150000000>;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	status = "okay";
};

&mmc1 {
	vmmc-supply = <&bldo1>;
	vqmmc-supply = <&aldo3>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	cap-sdio-irq;
	no-mmc;
	no-sd;
	no-1-8-v;
	max-frequency = <50000000>;
	status = "okay";

	wifi: wifi@1 {
		reg = <1>;
	};
};

/* Keep internal eMMC unavailable. */
&mmc2 {
	status = "disabled";
};

/* Match the shipped Brick MMC bank drive setting (raw value 3). */
&mmc0_pins {
	drive-strength = <40>;
};

&mmc1_pins {
	drive-strength = <40>;
};

&pio {
	vcc-pg-supply = <&aldo3>;
	compatible = "allwinner,sun50i-a133-pinctrl";
	vcc-pf18-supply = <&cldo1>;
	vcc-pf33-supply = <&cldo3>;

	pf_vqmmc: pf-regulator {
		regulator-name = "brick-pf-vqmmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};


	brick_bt_uart_pins: uart1-pg-pins {
		pins = "PG6", "PG7", "PG8", "PG9";
		function = "uart1";
	};

	ledc_pin: ledc-pin {
		pins = "PE5";
		function = "ledc";
	};



	dsi_active_pins: dsi-active-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4",
		       "PD5", "PD6", "PD7", "PD8", "PD9";
		function = "dsi0";
	};

	dsi_sleep_pins: dsi-sleep-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4",
		       "PD5", "PD6", "PD7", "PD8", "PD9";
		function = "io_disabled";
		bias-disable;
	};

	pwm0_pin: pwm0-pin {
		pins = "PD23";
		function = "pwm0";
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pin>;
	status = "okay";
};

&r_i2c0 {
	status = "okay";

	vdd_cpu: regulator@41 {
		compatible = "tcs,tcs4838";
		reg = <0x41>;
		regulator-name = "vdd-cpu";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <1257500>;
		regulator-always-on;
		tcs,runtime-voltage-selector = <0>;
	};

	pmic@34 {
		compatible = "trimui,brick-pmic";
		interrupt-parent = <&r_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reg = <0x34>;

		regulators {
			aldo3: aldo3 {
				regulator-name = "brick-aldo3";
				regulator-always-on;
			};

			aldo4: aldo4 {
				regulator-name = "brick-aldo4";
				regulator-always-on;
			};

			bldo1: bldo1 {
				regulator-name = "brick-bldo1";
				regulator-always-on;
			};

			cldo1: cldo1 {
				regulator-name = "brick-panel-cldo1";
				regulator-always-on;
			};
			cldo3: cldo3 {
				regulator-name = "brick-cldo3";
				regulator-always-on;
			};
			cldo4: cldo4 {
				regulator-name = "brick-panel-cldo4";
			};
		};
	};
};

&tcon_lcd0 {
	assigned-clocks = <&ccu CLK_PLL_VIDEO0_4X>, <&ccu CLK_TCON_LCD>;
	assigned-clock-parents = <0>, <&ccu CLK_PLL_VIDEO0_4X>;
	assigned-clock-rates = <612000000>, <306000000>;
	status = "okay";
};

&tcon_top {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&brick_bt_uart_pins>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "xradio,xr829-bt";
		clocks = <&rtc 0>, <&rtc 1>;
		clock-names = "lpo", "ref";
		vbat-supply = <&bldo1>;
		vddio-supply = <&aldo3>;
		reset-gpios = <&r_pio 0 2 GPIO_ACTIVE_LOW>;
		device-wake-gpios = <&r_pio 0 4 GPIO_ACTIVE_HIGH>;
	};
};

&usb_otg {
	compatible = "trimui,brick-musb", "allwinner,sun8i-a33-musb";
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	compatible = "trimui,brick-usb-phy", "allwinner,sun20i-d1-usb-phy";
	clocks = <&ccu CLK_USB_PHY0>, <&ccu CLK_USB_PHY1>, <&ccu CLK_BUS_EHCI1>;
	clock-names = "usb0_phy", "usb1_phy", "pmu1_clk";
	resets = <&ccu RST_USB_PHY0>, <&ccu RST_USB_PHY1>, <&ccu RST_BUS_EHCI1>;
	reset-names = "usb0_reset", "usb1_reset", "usb1_bus_reset";
	status = "okay";
};

&ledc {
	assigned-clocks = <&ccu CLK_LEDC>;
	assigned-clock-rates = <24000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&ledc_pin>;
	/* Small transfers use PIO; the A133 DMA controller is not validated. */
	/delete-property/ dmas;
	/delete-property/ dma-names;
	allwinner,pixel-format = "rgb";
	allwinner,t0h-ns = <400>;
	allwinner,t0l-ns = <850>;
	allwinner,t1h-ns = <800>;
	allwinner,t1l-ns = <450>;
	allwinner,treset-ns = <300000>;
	status = "okay";

	multi-led@0 {
		reg = <0>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <0>;
	};

	multi-led@1 {
		reg = <1>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <1>;
	};

	multi-led@2 {
		reg = <2>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <2>;
	};

	multi-led@3 {
		reg = <3>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <3>;
	};

	multi-led@4 {
		reg = <4>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <4>;
	};

	multi-led@5 {
		reg = <5>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <5>;
	};

	multi-led@6 {
		reg = <6>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <6>;
	};

	multi-led@7 {
		reg = <7>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <7>;
	};

	multi-led@8 {
		reg = <8>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <8>;
	};

	multi-led@9 {
		reg = <9>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <9>;
	};

	multi-led@a {
		reg = <10>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <10>;
	};

	multi-led@b {
		reg = <11>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <11>;
	};

	multi-led@c {
		reg = <12>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <12>;
	};

	multi-led@d {
		reg = <13>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <13>;
	};

	multi-led@e {
		reg = <14>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <14>;
	};

	multi-led@f {
		reg = <15>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <15>;
	};

	multi-led@10 {
		reg = <16>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <16>;
	};

	multi-led@11 {
		reg = <17>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <17>;
	};

	multi-led@12 {
		reg = <18>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <18>;
	};

	multi-led@13 {
		reg = <19>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <19>;
	};

	multi-led@14 {
		reg = <20>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <20>;
	};

	multi-led@15 {
		reg = <21>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <21>;
	};

	multi-led@16 {
		reg = <22>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <22>;
	};
};

&codec {
	avcc-supply = <&aldo4>;
	cpvin-supply = <&cldo1>;
	allwinner,pa-gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>; /* PH6 */
	allwinner,pa-delay-ms = <40>;
	allwinner,audio-routing = "Headphone", "HPOUTL",
				  "Headphone", "HPOUTR",
				  "Speaker", "HPOUTL",
				  "Speaker", "HPOUTR";
	status = "okay";
};

&ccu {
	compatible = "allwinner,sun50i-a133-ccu";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
	dynamic-power-coefficient = <190>;
};

&{/thermal-zones/cpu-thermal} {
	polling-delay-passive = <500>;
	polling-delay = <1000>;
	sustainable-power = <1200>;

	trips {
		cpu_threshold: cpu-threshold {
			temperature = <58000>;
			hysteresis = <0>;
			type = "passive";
		};

		cpu_passive: cpu-passive {
			temperature = <63000>;
			hysteresis = <0>;
			type = "passive";
		};

		cpu_critical: cpu-critical {
			temperature = <90000>;
			hysteresis = <0>;
			type = "critical";
		};
	};

	cooling-maps {
		map-cpu {
			trip = <&cpu_passive>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			contribution = <1024>;
		};
	};
};

&{/soc} {
	rtc: rtc@7000000 {
		compatible = "trimui,brick-rtc", "allwinner,sun50i-a133-rtc";
		#clock-cells = <1>;
		reg = <0x07000000 0x200>;
		interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&r_ccu CLK_R_AHB_BUS_RTC>;
		clock-names = "bus";
		resets = <&r_ccu RST_R_AHB_BUS_RTC>;
		reset-names = "bus";
	};
};

&pio {
	fn_switch_pin: fn-switch-pin {
		pins = "PH19";
		function = "gpio_in";
		bias-disable;
	};
};

&{/thermal-zones/gpu-thermal} {
	polling-delay-passive = <500>;
	polling-delay = <1000>;
	sustainable-power = <1100>;
};
