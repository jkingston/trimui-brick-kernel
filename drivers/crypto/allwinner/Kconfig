config CRYPTO_DEV_SUN50I_A133_CE
	tristate "Allwinner A133 Crypto Engine AES and SHA-256"
	depends on CRYPTO_DEV_ALLWINNER && PM
	select CRYPTO_SKCIPHER
	select CRYPTO_ECB
	select CRYPTO_CBC
	select CRYPTO_AES
	select CRYPTO_HASH
	select CRYPTO_SHA256
	select SGL_ALLOC
	help
	  AES ECB/CBC and SHA-256 digests on the A133 CE v4, with four
	  concurrent flows and isolated DMA buffers. Larger requests and
	  streaming hash updates use a software fallback.
	  Failed reset containment retains DMA resources until cold power-off.
	  System suspend drains queued work and rebuilds the engine state on
	  resume. Failed quiescence or restoration prevents further requests.

	  The module is called sun50i-a133-ce.

config CRYPTO_DEV_SUN50I_A133_CE_TRNG
	bool "Expose the A133 CE TRNG without entropy credit"
	depends on CRYPTO_DEV_SUN50I_A133_CE
	select HW_RANDOM
	help
	  Expose the A133 CE v4 TRNG transport through /dev/hwrng.  The
	  hardware source has zero registered entropy quality because its health
	  and conditioning guarantees have not been established.  The bytes
	  remain available for direct diagnostics and are mixed into the
	  random pool without crediting entropy.  Hardware errors return no
	  output and use the parent driver's recovery and DMA quarantine path.
	  Keep this disabled until CE operation has been qualified on the target.
	  Entropy credit requires separate source and health evidence.
